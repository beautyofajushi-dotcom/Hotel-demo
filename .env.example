# Optional ambient video URL. Keep empty to use the included dusk image treatment.
NEXT_PUBLIC_HERO_VIDEO_URL=

# WhatsApp Business direct-chat number: international digits only, no +, spaces or punctuation.
# When empty, the button opens WhatsApp's pre-filled share flow instead of a direct hotel chat.
NEXT_PUBLIC_HOTEL_WHATSAPP=

# Razorpay is intentionally not connected in this demo. Add credentials only to a secure
# server-side deployment when implementing order creation, signature checks and webhooks.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
